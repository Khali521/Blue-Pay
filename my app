
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BLUEPAY ADMIN PANEL</title>
<style>
    :root {
        --bg: #090e1a;
        --card: #16203a;
        --accent: #007bff;
        --text: #ffffff;
    }
    body { font-family: sans-serif; background: var(--bg); color: var(--text); padding: 20px; }
    h2 { color: var(--accent); border-bottom: 2px solid var(--accent); padding-bottom: 10px; }
    
    .stats { display: flex; gap: 20px; margin-bottom: 20px; }
    .stat-card { background: var(--card); padding: 20px; border-radius: 10px; flex: 1; text-align: center; }
    
    table { width: 100%; border-collapse: collapse; background: var(--card); border-radius: 10px; overflow: hidden; }
    th, td { padding: 12px; text-align: left; border-bottom: 1px solid #2d3a5a; }
    th { background: var(--accent); color: white; }
    
    .history-box { font-size: 11px; color: #8e99b0; max-height: 100px; overflow-y: auto; background: #0d1425; padding: 5px; border-radius: 5px; }
    .btn-refresh { background: #28a745; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; margin-bottom: 20px; }
    .btn-delete { background: #dc3545; color: white; border: none; padding: 5px 10px; border-radius: 3px; cursor: pointer; }
</style>
</head>
<body>

<h2>BLUEPAY - Admin Control Panel</h2>

<div class="stats">
    <div class="stat-card">
        <h3 id="total-users">0</h3>
        <p>Total Users</p>
    </div>
    <div class="stat-card">
        <h3 id="total-balance">₦0</h3>
        <p>User Liabilities</p>
    </div>
</div>

<button class="btn-refresh" onclick="loadAdminData()">🔄 Refresh Data</button>

<table>
    <thead>
        <tr>
            <th>User Info</th>
            <th>Credentials</th>
            <th>Balance</th>
            <th>Activity History</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody id="admin-table">
        </tbody>
</table>

<script>
function loadAdminData() {
    const users = JSON.parse(localStorage.getItem('bp_users') || '[]');
    const tableBody = document.getElementById('admin-table');
    const totalUsersText = document.getElementById('total-users');
    const totalBalText = document.getElementById('total-balance');
    
    tableBody.innerHTML = '';
    let totalBal = 0;

    if (users.length === 0) {
        tableBody.innerHTML = '<tr><td colspan="5" style="text-align:center">Babu kowa a cikin tsarin tukunna.</td></tr>';
    }

    users.forEach((user, index) => {
        totalBal += user.balance;
        
        // Tsara History
        let historyHtml = user.history && user.history.length > 0 
            ? user.history.map(h => `• ${h.type}: ₦${h.amt} (${h.details || 'No info'})`).join('<br>')
            : 'No transactions';

        const row = `
            <tr>
                <td>
                    <strong>${user.name}</strong><br>
                    <small>${user.phone}</small>
                </td>
                <td>
                    Pass: <code>${user.pass}</code><br>
                    PIN: <code>${user.pin}</code>
                </td>
                <td style="color:#28a745; font-weight:bold;">₦${user.balance.toLocaleString()}</td>
                <td>
                    <div class="history-box">${historyHtml}</div>
                </td>
                <td>
                    <button class="btn-delete" onclick="deleteUser(${index})">Ban</button>
                </td>
            </tr>
        `;
        tableBody.innerHTML += row;
    });

    totalUsersText.innerText = users.length;
    totalBalText.innerText = '₦' + totalBal.toLocaleString();
}

function deleteUser(index) {
    if (confirm("Kana son goge wannan mai amfani ne gaba daya?")) {
        let users = JSON.parse(localStorage.getItem('bp_users') || '[]');
        users.splice(index, 1);
        localStorage.setItem('bp_users', JSON.stringify(users));
        loadAdminData();
    }
}

// Kira bayanan farko
loadAdminData();
</script>

</body>
</html>
